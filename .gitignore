# Drupal 11 + DDEV project
# https://www.drupal.org/docs/develop/using-composer

# Composer-managed dependencies (restored with "ddev composer install").
/vendor/
/web/core/
/web/modules/contrib/
/web/themes/contrib/
/web/profiles/contrib/
/web/libraries/
/drush/Commands/contrib/

# Site settings. settings.php is committed; it contains no secrets and loads
# the files below. Local and DDEV-generated settings stay out of git.
/web/sites/*/settings.local.php
/web/sites/*/settings.ddev.php
/web/sites/*/default.settings.php
/web/sites/*/default.services.yml

# User-generated and temporary files.
/web/sites/*/files/
/web/sites/*/private/
/web/sites/*/translations/
/web/sites/*/tmp/
/web/sites/*/cache/
/private/

# Files placed by drupal/core-composer-scaffold on every "composer install".
/web/.csslintrc
/web/.eslintignore
/web/.eslintrc.json
/web/.ht.router.php
/web/.htaccess
/web/INSTALL.txt
/web/README.md
/web/autoload.php
/web/autoload_runtime.php
/web/example.gitignore
/web/index.php
/web/robots.txt
/web/update.php
/web/web.config
/web/modules/README.txt
/web/profiles/README.txt
/web/themes/README.txt
/web/sites/README.txt
/web/sites/development.services.yml
/web/sites/example.settings.local.php
/web/sites/example.sites.php

# Database dumps and archives.
*.sql
*.sql.gz
*.tar.gz

# OS / editor noise.
.DS_Store
.idea/
.vscode/
